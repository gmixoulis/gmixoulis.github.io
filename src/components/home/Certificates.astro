---
import { certificates, type Cert, type Stats } from '@/data/profile';
interface Props { certs: Cert[]; stats: Stats }
const { certs, stats } = Astro.props;
const [h, dim] = certificates.h(stats);
---

<section class="sec certs" id="certificates" tabindex="-1" aria-labelledby="h-cert">
  <div class="wrap head">
    <div>
      <h2 class="h2" id="h-cert" data-rv>{h} <span class="dim">{dim}</span></h2>
      <p class="tldr er-only">{stats.certs} certificates, from Cisco networking to Rust.</p>
    </div>
    <div class="ctrl" data-rv>
      <button class="ibtn mag" id="prev" type="button" aria-label="Previous certificates"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
      <button class="ibtn mag" id="next" type="button" aria-label="Next certificates"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
      <button class="tbtn mag" id="seeall" type="button" aria-haspopup="dialog">See all {stats.certs}</button>
    </div>
  </div>
  <div class="rail" id="rail" tabindex="0" role="region" aria-label="Certificates. Scroll sideways, drag, or use the arrow buttons.">
    <ul class="track">
      {certs.filter((c) => c.featured).map((c) => (
        <li class="card"><a href={c.src} target="_blank" rel="noopener noreferrer" draggable="false"><img src={c.src} width={c.w} height={c.h} alt={`Scan of the certificate: ${c.title}`} loading="lazy" decoding="async" draggable="false" /></a><p><small>{c.by}</small>{c.title}</p></li>
      ))}
    </ul>
  </div>
  <div class="rbar" aria-hidden="true"><i id="rbar"></i></div>
  <div class="certs-plain er-only">
    <ul style="list-style:none;margin:1.4em 0 0;padding:0;display:grid;gap:.45em">
      {certs.map((c) => <li><a href={c.src} target="_blank" rel="noopener noreferrer">{c.title}</a></li>)}
    </ul>
  </div>
</section>
