---
import { certificates, type Cert, type Stats } from '@/data/profile';
interface Props { certs: Cert[]; stats: Stats }
const { certs, stats } = Astro.props;
const [h, dim] = certificates.h(stats);
/* Gallery: the two degrees always first and biggest, then the other featured certificates. */
const degree = (c: Cert) => /^1(Master|Bachelor)-Degree/.test(c.file);
const featured = certs.filter((c) => c.featured);
const big = featured.filter(degree), rest = featured.filter((c) => !degree(c));
---

<section class="sec certs" id="certificates" tabindex="-1" aria-labelledby="h-cert">
  <div class="wrap">
    <div class="chead">
      <h2 class="h2" id="h-cert" data-rv>{h} <span class="dim">{dim}</span></h2>
    </div>
    <ul class="cbig" data-rv>
      {big.map((c) => (
        <li class="cg"><a href={c.src} target="_blank" rel="noopener noreferrer"><img src={c.src} width={c.w} height={c.h} alt={`Scan of the certificate: ${c.title}`} loading="lazy" decoding="async" /></a><p><small>{c.by}</small>{c.title}</p></li>
      ))}
    </ul>
    <ul class="cgrid" data-rv>
      {rest.map((c) => (
        <li class="cg"><a href={c.src} target="_blank" rel="noopener noreferrer"><img src={c.src} width={c.w} height={c.h} alt={`Scan of the certificate: ${c.title}`} loading="lazy" decoding="async" /></a><p><small>{c.by}</small>{c.title}</p></li>
      ))}
      <li class="call"><button id="seeall" type="button" aria-haspopup="dialog">See all {stats.certs} certificates<span class="ar" aria-hidden="true">→</span></button></li>
    </ul>
  </div>
</section>
