---
import { work } from '@/data/profile';
---

<section class="sec work" id="work" tabindex="-1" aria-labelledby="h-work">
  <div class="wrap work-g">
    <h2 class="h2" id="h-work" data-rv>{work.h[0]}{work.h[1] && <> <span class="dim">{work.h[1]}</span></>}</h2>
    <ol class="chain" data-rv>
      {work.roles.map((r) => (
        <li><article class="blk spot"><p class="when">{r.since && 'Since '}{r.when.map(([dt, label], i) => <>{i > 0 && '-'}<time datetime={dt}>{label}</time></>)}</p><div><h3>{r.title}</h3><p class="co">{r.org.map((o, i) => <>{i > 0 && ' '}{i > 0 && <span>/</span>}{i > 0 && ' '}{o}</>)}</p><p class="d">{r.d}</p></div></article></li>
      ))}
      <li aria-hidden="true" class="chain-fill" style="list-style:none;padding:0"></li>
    </ol>
    <div class="box" data-rv><h3 class="big">Education</h3><ul class="plain">
      {work.education.map((e) => <li><b>{e.b}</b><span>{e.span}{e.link && <a class="lnk" href={e.link.href} target="_blank" rel="noopener noreferrer">{e.link.text}</a>}{e.pdfs && <> ({e.pdfs.map((f, i) => <>{i > 0 && ' · '}<a class="lnk" href={f.href} target="_blank" rel="noopener">{f.text}</a></>)})</>}</span></li>)}
    </ul></div>
    <div class="box" data-rv><h3 class="big">Awards</h3><ul class="plain">
      {work.awards.map((a) => <li><b>{a.b}</b><span>{a.span}</span></li>)}
    </ul></div>
  </div>
</section>
