---
import { profile, linkedin } from '@/data/profile';
// The sandboxed iframe is created from #feed[data-src] by src/scripts/home/main.ts when this section comes near.
---

<section class="sec li" id="linkedin" tabindex="-1" aria-labelledby="h-li">
  <div class="wrap li-one">
    <div class="chead">
      <h2 class="h2" id="h-li" data-rv>{linkedin.h[0]} <span class="dim">{linkedin.h[1]}</span></h2>
      <a class="pill" data-rv href={profile.linkedin} target="_blank" rel="noopener noreferrer">Follow on LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="frame" data-rv>
      <div class="bar"><span class="url">{linkedin.url}</span></div>
      <div class="feed" id="feed" data-src={profile.linkedinWidget}>
        <div class="fb">
          <p class="ld">{linkedin.loading}</p>
          <p>{linkedin.failed}</p>
          <a href={profile.linkedinPosts} target="_blank" rel="noopener noreferrer">Read my posts on LinkedIn ↗</a>
        </div>
      </div>
    </figure>
    <p class="fine">{linkedin.fine}</p>
  </div>
</section>
