---
import { profile, type Stats } from '@/data/profile';
interface Props { stats: Stats }
const { stats } = Astro.props;
---

<section class="sec summary er-only" aria-labelledby="h-summary">
  <div class="wrap">
    <h2 class="h2" id="h-summary">In 30 seconds</h2>
    <ul class="quick" style="list-style:none;margin:1.2em 0 0;padding:0;display:grid;gap:.6em">
      <li>Now: Web3 full-stack developer at Cyberscope by TAC (since May 2026).</li>
      <li>I build smart contracts, on-chain integrations and React/Next.js frontends.</li>
      <li>I research blockchain for credentials, governance and 5G networks: {stats.papers} papers, {stats.cites} citations.</li>
      <li>Based in Thessaloniki, Greece; I work remotely.</li>
      <li>Email me: <a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    </ul>
  </div>
</section>
