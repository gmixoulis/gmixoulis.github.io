---
/**
 * Site header on every page. The homepage gets section anchors, a skip link and the scroll-driven states
 * (src/scripts/home/main.ts); other pages link the sections as /#id and keep the bar solid and 56px tall,
 * the height the garden layout already reserves.
 */
const path = Astro.url.pathname;
const home = path === '/';
const garden = path.startsWith('/garden');
/* The blog shows no header, only a way back and the theme toggle: the blog index goes home (seal 家, house), posts and
   tag pages go to the index (seal 庭, garden). */
const back = path.replace(/\/$/, '') === '/garden' ? { href: '/', label: 'Home', seal: '家' } : { href: '/garden/', label: 'Blog', seal: '庭' };
const sections = [
  ['about', 'About'], ['skills', 'Skills'], ['work', 'Experience'], ['research', 'Research'], ['certificates', 'Certificates'],
  ['projects', 'Projects'], ['activities', 'Activities'], ['linkedin', 'LinkedIn'], ['contact', 'Contact'],
];
---

{garden ? (<>
  <a class="back" href={back.href}><i class="seal" aria-hidden="true">{back.seal}</i>{back.label}</a>
  <button class="pill tg float" id="theme" type="button" aria-label="Switch to light theme"><i aria-hidden="true"></i><span>Light</span></button>
</>) : (<>
{home && <a class="skip" href="#main">Skip to content</a>}
<header class:list={['nav', !home && 'scrolled inner']} id="nav">
  <a class="brand" href={home ? '#top' : '/'}>George Michoulis</a>
  <button class="pill menu" type="button" aria-expanded="false" aria-controls="links"><span>Menu</span></button>
  <nav aria-label="Sections"><ul class="links" id="links">
    {sections.map(([id, label]) => <li><a href={home ? `#${id}` : `/#${id}`}>{label}</a></li>)}
    <li class="ext"><a href="/garden/">Blog</a></li>
    <li aria-hidden="true" class="ind"></li>
  </ul></nav>
  <a class="pill play" href="/play/" aria-label="Play Ledger Run, my CV as a platformer"><i aria-hidden="true"></i>Play</a>
  <button class="pill tg" id="theme" type="button" aria-label="Switch to light theme"><i aria-hidden="true"></i><span>Light</span></button>
</header>
</>)}

<script>
  import '@/scripts/home/nav';
</script>

<style is:global>
  /* Design tokens (dark, then light) and the header. Global because the header is on every page;
     the rest of the homepage CSS is in src/styles/home.css. --rim is the prototype's --ring, renamed so it
     doesn't override the --ring that global.css (shadcn) uses for the garden's focus outlines. */
  :root{
    --bg:#0a0a0b;--panel:#111114;--line:rgba(255,255,255,.08);--line-2:rgba(255,255,255,.15);
    --fg:#ededef;--fg-2:#a6a6b0;--fg-3:#8c8c96;--dim:#8a8a95;
    --a1:#7ee8f2;--a2:#8ea2ff;--a3:#c49bff;--a4:#ffb9a3;
    --h1a:#fff;--h1b:#9d9daa;--nav:rgba(10,10,11,.74);--pop:#121215;
    --btn:#141418;--btn-h:#1b1b21;--rim:#3a3a44;--btn-fg:#fff;--solid:#f2f2f4;--solid-fg:#0a0a0b;
    --glow:rgba(142,162,255,.22);--spot:rgba(142,162,255,.09);--sel:rgba(142,162,255,.35);--shade:rgba(0,0,0,.9);
    --acc:linear-gradient(90deg,var(--a1),var(--a2) 38%,var(--a3) 68%,var(--a4));
    /* Fonts API variables (homepage only); other pages fall back to the fonts they already load. */
    --display:var(--font-funnel,var(--font-shippori,serif));--ui:var(--font-geist,var(--font-source-sans,sans-serif));--mono:var(--font-geist-mono,monospace);
    --ease:cubic-bezier(.23,1,.32,1);--pad:clamp(16px,4vw,48px);--max:1240px;
    --rail-pad:max(var(--pad),calc((100vw - var(--max))/2));
  }
  /* Light (plan 011), an Aegean shore. 60 water-white sand / 30 turquoise water, blue olive shade and teal type /
     10 sun: gold + coral. No RGB: the accent is the sun's gold-to-coral. */
  [data-theme=light]{
    --bg:#faf6ee;--panel:#fffefb;--line:rgba(10,90,100,.12);--line-2:rgba(10,90,100,.2);
    --fg:#0a2a33;--fg-2:#2e5560;--fg-3:#3d6470;--dim:#476d78;
    --a1:#e9a62a;--a2:#0c6f7e;--a3:#c2401f;--a4:#e9a62a;
    --h1a:#0a2a33;--h1b:#0c6f7e;--nav:rgba(250,246,238,.82);--pop:#fffefb;
    --btn:#fffefb;--btn-h:#fff;--rim:#bfdadb;--btn-fg:#0a2a33;--solid:#c2401f;--solid-fg:#fff;
    --glow:rgba(233,166,42,.2);--spot:rgba(12,111,126,.06);--sel:rgba(12,111,126,.18);--shade:rgba(8,95,110,.22);
    --acc:linear-gradient(90deg,#e9a62a,#c2401f);
  }
  .skip{position:fixed;left:12px;top:-60px;z-index:50;background:var(--solid);color:var(--solid-fg);padding:8px 14px;border-radius:8px}
  .skip:focus{top:12px}
  .nav :focus-visible,.skip:focus-visible{outline:2px solid var(--a2);outline-offset:3px;border-radius:6px}

  .nav{position:fixed;inset:0 0 auto;z-index:20;height:60px;display:flex;align-items:center;gap:18px;padding:0 var(--pad);border-bottom:1px solid transparent;transition:background-color .4s,border-color .4s;
    font:400 16px/1.6 var(--ui);color:var(--fg)}
  .nav.inner{height:56px}
  .nav.scrolled{background:var(--nav);-webkit-backdrop-filter:saturate(1.4) blur(14px);backdrop-filter:saturate(1.4) blur(14px);border-color:var(--line)}
  .brand{font:600 16px var(--display);letter-spacing:-.02em;white-space:nowrap;opacity:0;transform:translateY(4px);transition:opacity .4s,transform .4s var(--ease)}
  .scrolled .brand,.brand:focus-visible{opacity:1;transform:none}
  .links{margin:0 0 0 auto;padding:0;list-style:none;display:flex;gap:0;position:relative}
  .links a{display:block;padding:8px 9px;font-size:13.5px;color:var(--fg-2);white-space:nowrap;transition:color .25s}
  .links a:hover,.links a.on{color:var(--fg)}
  .links .ext{margin-left:8px;padding-left:8px;border-left:1px solid var(--line-2)}
  .ind{position:absolute;left:0;bottom:1px;height:1px;width:0;background:var(--acc);opacity:0;transition:transform .55s var(--ease),width .55s var(--ease),opacity .3s}
  .pill{height:34px;display:inline-flex;align-items:center;gap:8px;padding:0 13px;border-radius:9px;border:1px solid var(--line-2);background:transparent;color:var(--fg);font:500 13.5px var(--ui);cursor:pointer;white-space:nowrap;transition:border-color .25s,transform .16s var(--ease)}
  .pill:hover{border-color:var(--fg-3)}.pill:active{transform:scale(.97)}
  .play{border-color:transparent;background:linear-gradient(var(--bg),var(--bg)) padding-box,var(--acc) border-box}
  .play i{width:8px;height:9px;background:var(--acc);clip-path:polygon(0 0,100% 50%,0 100%)}
  .tg i{width:10px;height:10px;border:1.5px solid currentColor;border-radius:2.5px;transform:rotate(45deg);background:linear-gradient(90deg,currentColor 50%,transparent 50%)}
  [data-theme=light] .tg i{width:9px;height:9px;border-radius:50%;background:currentColor;transform:none;
    box-shadow:0 -6px 0 -3px currentColor,0 6px 0 -3px currentColor,-6px 0 0 -3px currentColor,6px 0 0 -3px currentColor}
  .er i{font-style:normal;font-weight:700;font-size:11px;line-height:1;letter-spacing:-.03em}
  .er[aria-pressed=true]{border-color:var(--a2);color:var(--fg)}
  .menu{display:none}

  /* The theme-switch veil (nav.ts). The light veil is the light --bg, the night veil the dark --bg. */
  @property --iris{syntax:'<length>';inherits:false;initial-value:0px}
  .veil{position:fixed;inset:0;z-index:100;overflow:hidden;background:#faf6ee;transform:translateY(-101%)}
  .veil.up{background:#0a0a0b;transform:translateY(101%)}
  .veil.iris{-webkit-mask:radial-gradient(circle,transparent var(--iris),#000 calc(var(--iris) + 1px));mask:radial-gradient(circle,transparent var(--iris),#000 calc(var(--iris) + 1px))}
  /* the sun: white-hot centre, yellow edge, a wide warm glare and slow soft rays (not an egg yolk) */
  .veil i{position:absolute;left:50%;top:50%;width:min(30vmin,240px);aspect-ratio:1;border-radius:50%;opacity:0;transform:translate(-50%,-50%);
    background:radial-gradient(circle,#fffef6 0,#fff8d8 38%,#ffe48a 66%,#ffc54d 86%,#ffab38 100%);
    box-shadow:0 0 22px 6px rgba(255,248,214,.95),0 0 70px 30px rgba(255,214,120,.6),0 0 170px 80px rgba(255,180,80,.3),0 0 360px 160px rgba(255,170,90,.14)}
  .veil i::before{content:'';position:absolute;inset:-60%;border-radius:50%;z-index:-1;filter:blur(2px);animation:sunrays 30s linear infinite;
    background:repeating-conic-gradient(rgba(255,226,150,0) 0deg 7deg,rgba(255,226,150,.36) 9deg,rgba(255,226,150,0) 11deg 18deg);
    -webkit-mask:radial-gradient(closest-side,transparent 44%,#000 50%,transparent 100%);mask:radial-gradient(closest-side,transparent 44%,#000 50%,transparent 100%)}
  @keyframes sunrays{to{transform:rotate(1turn)}}
  /* the moon is a canvas drawn once in veil.ts; stars and a warm horizon glow sit behind it */
  .veil canvas{position:absolute;left:50%;top:50%;width:min(30vmin,240px);height:auto;aspect-ratio:1;border-radius:50%;opacity:0;transform:translate(-50%,-50%);
    box-shadow:0 0 24px 4px rgba(225,232,255,.45),0 0 90px 30px rgba(200,214,255,.22),0 0 220px 90px rgba(160,185,255,.1)}
  .veil s,.veil u,.veil em{position:absolute;inset:0;opacity:0;pointer-events:none}
  /* the day sky behind the sun: Aegean blue, paler and a little warm toward the horizon */
  .veil s{background:linear-gradient(#6fb8de,#a9d8ec 52%,#e6eef0 82%,#f4e7d2)}
  .veil em{background:radial-gradient(ellipse 85% 48% at 50% 104%,rgba(255,150,92,.85),rgba(255,118,96,.28) 48%,transparent 76%)}

  /* Blog header (plan 012): real buttons in brushed ink with a red hanko seal (家 home, 庭 blog, 月/日 on the theme
     switch). The rough edge is the garden's own #z-sumi filter (GardenLayout); the label stays crisp. Paper in dark. */
  .back,.float{position:fixed;top:14px;z-index:30;height:38px;display:inline-flex;align-items:center;gap:9px;padding:0 18px 0 10px;border:0;border-radius:3px;
    background:none;isolation:isolate;color:#f4efe4;font:500 14px var(--font-shippori,serif);letter-spacing:.03em;text-decoration:none;cursor:pointer;transition:transform .2s var(--ease)}
  .back{left:var(--pad)}.float{right:var(--pad)}
  .back::before,.float::before{content:'';position:absolute;inset:-1px -3px;z-index:-1;background:#16130f;border-radius:6px 3px 7px 4px;filter:url(#z-sumi)}
  .dark .back,.dark .float{color:#16130f}
  .dark .back::before,.dark .float::before{background:#efe8da}
  .back .seal,.float.tg i{display:inline-grid;place-items:center;width:22px;height:22px;border:0;border-radius:2px;background:#c43c2c;color:#fbf3e6;box-shadow:none;
    font:400 15px/1 "Yuji Syuku","Hiragino Mincho ProN",serif;font-style:normal;transform:rotate(-3deg);transition:transform .3s var(--ease)}
  .float.tg i::before{content:'月'}.dark .float.tg i::before{content:'日'}
  .back:hover,.float:hover{transform:translateY(-1px)}.back:hover .seal,.float:hover i{transform:rotate(3deg)}
  .back:active,.float:active{transform:scale(.97)}
  .back:focus-visible,.float:focus-visible{outline:2px solid #c43c2c;outline-offset:4px}

  @media (max-width:1180px){
    .nav{gap:10px}
    .links{display:none;position:absolute;top:62px;left:var(--pad);right:var(--pad);flex-direction:column;padding:8px;border-radius:14px;border:1px solid var(--line-2);background:var(--pop);box-shadow:0 24px 60px var(--shade)}
    .nav.inner .links{top:58px}
    .nav.open .links{display:flex}
    .links a{padding:11px 14px;font-size:16px}
    .links .ext{margin:6px 0 0;padding:6px 0 0;border-left:0;border-top:1px solid var(--line)}
    .ind{display:none}
    .menu{display:inline-flex;margin-left:auto}
  }
  @media (max-width:860px){ .brand{display:none} }
  @media (max-width:560px){ .pill{padding:0 11px} }
</style>
