---
import { activities } from '@/data/profile';
---

<section class="sec acts" id="activities" tabindex="-1" aria-labelledby="h-acts">
  <div class="wrap">
    <h2 class="h2" id="h-acts" data-rv>{activities.h[0]} <span class="dim">{activities.h[1]}</span></h2>
    <ul class="shelf" data-rv>
      {activities.items.map((a) => (
        <li class="act"><div class="gw">
          {a.glyph === 'fitness' && (<svg class="gl" viewBox="-24.0 -54.3 77.6 95" width="78" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="-21.0,9.9 -13.7,14.1 -13.7,-10.1 -21.0,-14.3"/><polygon class="fr" points="7.2,2.0 -13.7,14.1 -13.7,-10.1 7.2,-22.2"/><polygon class="ft" points="0.0,-26.4 7.2,-22.2 -13.7,-10.1 -21.0,-14.3"/><polygon class="fl" points="-5.1,-0.8 31.1,20.1 31.1,15.7 -5.1,-5.2"/><polygon class="fr" points="34.9,17.9 31.1,20.1 31.1,15.7 34.9,13.5"/><polygon class="ft" points="-1.3,-7.4 34.9,13.5 31.1,15.7 -5.1,-5.2"/><polygon class="fl" points="22.5,35.0 29.7,39.2 29.7,15.0 22.5,10.8"/><polygon class="fr" points="50.7,27.1 29.7,39.2 29.7,15.0 50.7,2.9"/><polygon class="ft" points="43.4,-1.3 50.7,2.9 29.7,15.0 22.5,10.8"/></svg>)}
          {a.glyph === 'news' && (<svg class="gl" viewBox="-30.6 -58.9 70.6 95" width="71" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="-27.6,15.9 4.8,34.6 4.8,31.8 -27.6,13.1"/><polygon class="fr" points="28.6,20.9 4.8,34.6 4.8,31.8 28.6,18.0"/><polygon class="ft" points="-3.8,-0.7 28.6,18.0 4.8,31.8 -27.6,13.1"/><polygon class="fl" points="-23.4,14.2 9.0,32.9 9.0,30.0 -23.4,11.3"/><polygon class="fr" points="32.8,19.1 9.0,32.9 9.0,30.0 32.8,16.3"/><polygon class="ft" points="0.4,-2.4 32.8,16.3 9.0,30.0 -23.4,11.3"/><polygon class="fl" points="-19.2,12.4 13.1,31.1 13.1,28.0 -19.2,9.4"/><polygon class="fr" points="37.0,17.4 13.1,31.1 13.1,28.0 37.0,14.3"/><polygon class="ft" points="4.6,-4.4 37.0,14.3 13.1,28.0 -19.2,9.4"/><g transform="matrix(19.053,11.000,-19.053,11.000,4.57,-4.40)" class="ln"><path d="M.25 .3H1.25M.25 .58H1.45M.25 .8H1.3M.25 1.02H.95"/></g></svg>)}
          {a.glyph === 'languages' && (<svg class="gl" viewBox="-22.1 -65.5 69.8 95" width="70" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="-19.1,11.0 0.0,22.0 0.0,0.0 -19.1,-11.0"/><polygon class="fr" points="19.1,11.0 0.0,22.0 0.0,0.0 19.1,-11.0"/><polygon class="ft" points="0.0,-22.0 19.1,-11.0 0.0,0.0 -19.1,-11.0"/><text transform="matrix(19.053,11.000,0,22.000,-19.05,-11.00)" x=".5" y=".74" class="tx">A</text><polygon class="fl" points="10.5,18.2 27.6,28.1 27.6,8.2 10.5,-1.6"/><polygon class="fr" points="44.8,18.2 27.6,28.1 27.6,8.2 44.8,-1.6"/><polygon class="ft" points="27.6,-11.6 44.8,-1.6 27.6,8.2 10.5,-1.6"/><text transform="matrix(19.053,11.000,0,22.000,10.48,-1.65)" x=".45" y=".68" class="tx">Ω</text></svg>)}
          {a.glyph === 'anime' && (<svg class="gl" viewBox="-12.3 -74.2 46.8 95" width="47" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="4.8,15.9 10.5,19.2 10.5,10.0 4.8,6.7"/><polygon class="fr" points="16.2,15.9 10.5,19.2 10.5,10.0 16.2,6.7"/><polygon class="ft" points="10.5,3.4 16.2,6.7 10.5,10.0 4.8,6.7"/><polygon class="fl" points="-9.3,-3.9 28.8,18.1 28.8,-9.3 -9.3,-31.3"/><polygon class="fr" points="31.4,16.6 28.8,18.1 28.8,-9.3 31.4,-10.9"/><polygon class="ft" points="-6.7,-32.9 31.4,-10.9 28.8,-9.3 -9.3,-31.3"/><g transform="matrix(19.053,11.000,0,22.000,-9.34,-31.35)"><polygon class="mk" points=".82,.38 .82,.88 1.26,.63"/></g></svg>)}
          {a.glyph === 'theatre' && (<svg class="gl" viewBox="-31.6 -51.7 78.4 95" width="78" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="-28.6,16.5 15.2,41.8 15.2,35.2 -28.6,9.9"/><polygon class="fr" points="43.8,25.3 15.2,41.8 15.2,35.2 43.8,18.7"/><polygon class="ft" points="0.0,-6.6 43.8,18.7 15.2,35.2 -28.6,9.9"/><polygon class="fl" points="0.8,14.3 9.5,19.4 9.5,9.2 0.8,4.2"/><polygon class="fr" points="18.3,14.3 9.5,19.4 9.5,9.2 18.3,4.2"/><polygon class="ft" points="9.5,-0.9 18.3,4.2 9.5,9.2 0.8,4.2"/><polygon class="beam" points="9.5,-47.3 -7.2,14.3 26.2,14.3"/><ellipse class="pool" cx="9.5" cy="14.3" rx="16.7" ry="9.6"/></svg>)}
          {a.glyph === 'citizen' && (<svg class="gl" viewBox="-24.9 -66.0 53.6 95" width="54" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="-21.9,12.6 3.8,27.5 3.8,3.3 -21.9,-11.6"/><polygon class="fr" points="25.7,14.9 3.8,27.5 3.8,3.3 25.7,-9.4"/><polygon class="ft" points="0.0,-24.2 25.7,-9.4 3.8,3.3 -21.9,-11.6"/><g transform="matrix(19.053,11.000,-19.053,11.000,0.00,-24.20)" class="ln"><path d="M.3 .6H1.05"/></g><polygon class="fl slip" points="-4.8,-13.5 7.0,-6.7 7.0,-20.4 -4.8,-27.2"/><polygon class="fr slip" points="8.0,-7.3 7.0,-6.7 7.0,-20.4 8.0,-20.9"/><polygon class="ft slip" points="-3.8,-27.7 8.0,-20.9 7.0,-20.4 -4.8,-27.2"/><g transform="matrix(19.053,11.000,0,22.000,-4.76,-27.17)" class="ln"><path d="M.16 .3L.27 .42L.47 .18"/></g></svg>)}
          {a.glyph === 'hackathons' && (<svg class="gl" viewBox="-20.1 -53.9 74.6 95" width="75" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="-17.1,9.9 0.0,19.8 0.0,-2.2 -17.1,-12.1"/><polygon class="fr" points="17.1,9.9 0.0,19.8 0.0,-2.2 17.1,-12.1"/><polygon class="ft" points="0.0,-22.0 17.1,-12.1 0.0,-2.2 -17.1,-12.1"/><text transform="matrix(19.053,11.000,0,22.000,-17.15,-12.10)" x=".45" y=".62" class="tx">2</text><polygon class="fl" points="0.0,19.8 17.1,29.7 17.1,-2.2 0.0,-12.1"/><polygon class="fr" points="34.3,19.8 17.1,29.7 17.1,-2.2 34.3,-12.1"/><polygon class="ft" points="17.1,-22.0 34.3,-12.1 17.1,-2.2 0.0,-12.1"/><text transform="matrix(19.053,11.000,0,22.000,0.00,-12.10)" x=".45" y=".62" class="tx">1</text><polygon class="fl hi" points="17.1,29.7 34.3,39.6 34.3,24.2 17.1,14.3"/><polygon class="fr hi" points="51.4,29.7 34.3,39.6 34.3,24.2 51.4,14.3"/><polygon class="ft hi" points="34.3,4.4 51.4,14.3 34.3,24.2 17.1,14.3"/><text transform="matrix(19.053,11.000,0,22.000,17.15,14.30)" x=".45" y=".55" class="tx hi">3</text></svg>)}
          {a.glyph === 'volunteering' && (<svg class="gl" viewBox="-13.3 -75.5 46.8 95" width="47" height="95" aria-hidden="true" focusable="false"><polygon class="fl" points="-10.3,-4.0 27.8,18.0 27.8,-8.4 -10.3,-30.4"/><polygon class="fr" points="30.5,16.5 27.8,18.0 27.8,-8.4 30.5,-9.9"/><polygon class="ft" points="-7.6,-31.9 30.5,-9.9 27.8,-8.4 -10.3,-30.4"/><g transform="matrix(19.053,11.000,0,22.000,-10.29,-30.36)"><polygon class="fl" points=".35,1.19 .35,1.55 .8,1.19"/><circle class="mk" cx=".62" cy=".6" r=".1"/><circle class="mk" cx="1" cy=".6" r=".1"/><circle class="mk" cx="1.38" cy=".6" r=".1"/></g></svg>)}
        </div><h3>{a.h}</h3><p>{a.p}</p></li>
      ))}
    </ul>
  </div>
</section>
